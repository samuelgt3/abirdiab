# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".

# Set to True only on your own computer while developing.
DEBUG=True

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5432/abirdiab

# The address of the website (no trailing slash). Several can be listed, separated by commas.
SITE_URL=http://localhost:5173
SITE_URLS=http://localhost:5173

# Production only: the domain(s) this Django server answers on, e.g. api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Phase 4 (leave empty until you have them; the website tells you what is still unconnected in Admin > Settings)
# The public address of THIS server (Paymob calls it back here). No trailing slash.
API_URL=http://localhost:8000
# Card payments (Paymob dashboard > Settings). Use the TEST keys first.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Paymob needs EITHER the HMAC secret OR the API key (Settings > API Keys). With only the API key, the server asks Paymob
# directly about every payment instead of checking a signature. Use the HMAC secret when you have it.
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_IDS=
# Only outside Egypt: https://ksa.paymob.com, https://uae.paymob.com or https://oman.paymob.com
PAYMOB_BASE_URL=
# A unique video call for every 1:1 session (Zoom Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Emails (resend.com). MAIL_FROM looks like: Abir Diab <bookings@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=

# ---- Phase 5
# A long random text. The scheduler sends it in the "x-cron-secret" header when it calls /api/fn/cron
CRON_SECRET=
# Codes by SMS / WhatsApp (Twilio Verify). Email codes need nothing extra.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client, type "Web application").
# Authorised redirect URI to add there:  <API_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
