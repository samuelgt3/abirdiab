# Copy this file to ".env.local" and fill in the values.

# Public address of the Django API (ends with /api). On your own computer: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Public address of the website (no trailing slash) - used for the sitemap, share image and canonical links
VITE_SITE_URL=

# Contact details shown on the site
VITE_WHATSAPP=
VITE_CONTACT_EMAIL=

# Bunny Stream library number (paid / free course videos)
VITE_BUNNY_LIBRARY_ID=
